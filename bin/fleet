#!/usr/bin/env bash
# fleet: the mechanics behind a two-level fleet of agents. The user talks to
# the orchestrator; it runs one project lead per registered project; each project
# lead runs the workers that change that project.
#
# Every task is a folder under $FLEET_HOME/tasks/<name>/ holding brief.md (the
# project lead's instructions), meta (what this script recorded), status (lines the
# agent appends), sent (news a session's hook delivered and that session has
# not acked yet), and up (the outcome last passed to the orchestrator). A project lead
# is itself a task, lead-<project>, whose status lines are its reports to the
# orchestrator. Every agent runs in an hc terminal detached from whoever started
# it, so any agent can die and its replacement picks up from these files. Run
# `fleet help` for commands.
set -euo pipefail

die() { echo "fleet: $*" >&2; exit 1; }

# Forward-slash paths work in Git Bash, Windows tools, and hc alike.
mixed() { if command -v cygpath >/dev/null 2>&1; then cygpath -m "$1"; else printf '%s\n' "$1"; fi; }

FLEET_HOME=$(mixed "${FLEET_HOME:-$HOME/.fleet}")
TASKS=$FLEET_HOME/tasks
# The project registry: one "<name><TAB><repo><TAB><description>" line each.
PROJECTS=$FLEET_HOME/projects
# One folder per orchestrator or project lead session, named by its Claude Code session id: the
# project it leads (absent for the orchestrator) and its hook's pid.
SESSIONS=$FLEET_HOME/sessions
SESSION=${CLAUDE_CODE_SESSION_ID:-}
# This repo: project leads run here, where the orchestrate skill lives.
FLEET_ROOT=$(mixed "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)")
HC=${FLEET_HC:-$(command -v hc || command -v hc.exe || true)}

need() {
  [ -n "$HC" ] || die "hc not found; add it to PATH or set FLEET_HC"
  command -v jq >/dev/null 2>&1 || die "jq not found"
}

# jq -r without the carriage returns jq.exe adds on Windows.
jqr() { jq -r "$@" | tr -d '\r'; }

kebab() { # <kind> <name>
  [[ $2 =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || die "$1 name must be kebab-case: $2"
}

task_dir() {
  kebab task "$1"
  printf '%s\n' "$TASKS/$1"
}

meta_get() { # <name> <key>
  sed -n "s/^$2=//p" "$TASKS/$1/meta" | tail -n 1
}

meta_set() { # <name> <key> <value>
  local file=$TASKS/$1/meta
  { grep -v "^$2=" "$file" || true; printf '%s=%s\n' "$2" "$3"; } > "$file.tmp"
  mv "$file.tmp" "$file"
}

status_lines() { # <name>
  local file=$TASKS/$1/status
  if [ -f "$file" ]; then wc -l < "$file" | tr -d ' '; else echo 0; fi
}

# The agent as one word: starting, working, idle, blocked, error, exited, or
# gone (no terminal). hc reports a finished turn as "done"; that is idle here,
# so it never reads as the worker's own done: line. Prints "<word> <turn>".
worker() { # <name>
  local json
  json=$("$HC" get "$1" --json 2>/dev/null) || { echo "gone 0"; return; }
  printf '%s' "$json" | jqr '
    (if .state != "live" then "exited"
     else (.status.state // "starting" | if . == "done" then "idle" else . end)
     end) + " " + ((.turn // 0) | tostring)'
}

usage() {
  cat <<'EOF'
fleet project add <name> <repo> <description>
                                          register a project
fleet project ls                          list registered projects
fleet scope [<project>]                   make this session the project's lead, or
                                          say which role this session has
fleet lead <project>                      start the project's lead (orchestrator only)
fleet report <text>                       pass a report to the orchestrator (project lead only)
fleet new <name>                          create a task and print its brief path
fleet spawn <name> <implement|investigate> <project>
                                          start a worker on the filled-in brief
                                          (that project's lead only)
fleet relaunch <name>                     start a new agent on an existing task
fleet wait [--timeout SECONDS]            block until a task needs this session (default 100)
fleet ack <name>                          mark a task's news as handled
fleet hook                                every session's Stop hook; run by Claude Code
fleet ls                                  one line per task this session supervises
fleet digest                              where things stand, by project: needs you,
                                          underway, finished, recently landed
fleet clean <name> [--discard]            stop the agent, remove its worktree and task,
                                          and log what it delivered; refuses unlanded
                                          work unless --discard
EOF
}

# --- projects -------------------------------------------------------------

project_repo() { # <name>: its repo, or nothing
  [ ! -f "$PROJECTS" ] || awk -F'\t' -v n="$1" '$1 == n { print $2; exit }' "$PROJECTS"
}

# A repo's project name; an unregistered repo goes by its folder name.
project_of() { # <repo>
  local name=""
  [ ! -f "$PROJECTS" ] || name=$(awk -F'\t' -v r="$1" '$2 == r { print $1; exit }' "$PROJECTS")
  printf '%s\n' "${name:-$(basename "$1")}"
}

need_project() { # <name>: its repo, or die
  local repo; repo=$(project_repo "$1")
  [ -n "$repo" ] || die "no project $1; see fleet project ls"
  printf '%s\n' "$repo"
}

cmd_project() {
  case ${1:-} in
    add)
      [ $# -ge 4 ] || die "usage: fleet project add <name> <repo> <description>"
      local name=$2 repo taken=""
      kebab project "$name"
      [ -z "$(project_repo "$name")" ] || die "project $name is already registered"
      repo=$(git -C "$3" rev-parse --show-toplevel 2>/dev/null) || die "not a git repo: $3"
      [ ! -f "$PROJECTS" ] || taken=$(awk -F'\t' -v r="$repo" '$2 == r { print $1; exit }' "$PROJECTS")
      [ -z "$taken" ] || die "$repo is already registered as $taken"
      mkdir -p "$FLEET_HOME"
      printf '%s\t%s\t%s\n' "$name" "$repo" "${*:4}" >> "$PROJECTS"
      echo "registered $name ($repo)"
      ;;
    ls)
      [ -s "$PROJECTS" ] || { echo "(no projects; add one with fleet project add)"; return; }
      awk -F'\t' '{ printf "%-20s %s\n%-20s %s\n", $1, $3, "", $2 }' "$PROJECTS"
      ;;
    *) die "usage: fleet project add <name> <repo> <description> | fleet project ls" ;;
  esac
}

# --- sessions and project leads ------------------------------------------

# The project this session leads, or nothing for the orchestrator.
scope() {
  [ -z "$SESSION" ] || cat "$SESSIONS/$SESSION/project" 2>/dev/null || true
}

tasks() {
  local meta
  for meta in "$TASKS"/*/meta; do
    [ -f "$meta" ] && basename "$(dirname "$meta")"
  done
  return 0
}

# The worker tasks in a repo.
project_tasks() { # <repo>
  local name
  for name in $(tasks); do
    if [ "$(meta_get "$name" role)" != lead ] && [ "$(meta_get "$name" repo)" = "$1" ]; then
      echo "$name"
    fi
  done
}

# The tasks this session supervises: the orchestrator supervises the project
# leads; a project lead supervises its project's workers.
my_tasks() {
  local project name
  project=$(scope)
  if [ -n "$project" ]; then project_tasks "$(project_repo "$project")"; return; fi
  for name in $(tasks); do
    [ "$(meta_get "$name" role)" != lead ] || echo "$name"
  done
}

cmd_scope() {
  [ $# -le 1 ] || die "usage: fleet scope [<project>]"
  [ -n "$SESSION" ] || die "CLAUDE_CODE_SESSION_ID is not set; run this from the orchestrator's or a project lead's session"
  local project
  if [ $# -eq 0 ]; then
    project=$(scope)
    if [ -n "$project" ]; then echo "this session leads project $project"; else echo "this session is the orchestrator"; fi
    return
  fi
  project=$1
  need_project "$project" >/dev/null
  [ -f "$TASKS/lead-$project/meta" ] \
    || die "project leads are started by the orchestrator, with: fleet lead $project"
  mkdir -p "$SESSIONS/$SESSION"
  printf '%s\n' "$project" > "$SESSIONS/$SESSION/project"
  echo "this session leads project $project; reach the orchestrator with fleet report"
}

cmd_lead() {
  [ $# -eq 1 ] || die "usage: fleet lead <project>"
  need
  [ -z "$(scope)" ] || die "only the orchestrator starts project leads"
  local project=$1 repo name dir
  repo=$(need_project "$project")
  name=lead-$project
  dir=$(task_dir "$name")
  [ ! -e "$dir/meta" ] || die "$name already exists; if it stopped, use fleet relaunch $name"
  ! "$HC" get "$name" --json >/dev/null 2>&1 || die "an hc terminal named $name already exists"
  mkdir -p "$dir"
  printf 'role=lead\nproject=%s\nrepo=%s\ncwd=%s\nseen=0\nacked_state=\nacked_turn=0\n' \
    "$project" "$repo" "$FLEET_ROOT" > "$dir/meta"
  : > "$dir/status"
  launch "$name"
}

cmd_report() {
  [ $# -ge 1 ] || die "usage: fleet report <text>"
  local project; project=$(scope)
  [ -n "$project" ] || die "only a project lead reports; the orchestrator talks to the user"
  printf 'report: %s\n' "$*" >> "$TASKS/lead-$project/status"
}

# --- tasks ----------------------------------------------------------------

cmd_new() {
  [ $# -eq 1 ] || die "usage: fleet new <name>"
  local dir; dir=$(task_dir "$1")
  [[ $1 != lead-* ]] || die "task names starting with lead- are reserved for project leads"
  [ ! -e "$dir" ] || die "task $1 already exists: $dir"
  mkdir -p "$dir"
  cat > "$dir/brief.md" <<EOF
# $1

## Intent
<The user's words for this task, verbatim. Append later changes here, verbatim.>

## Spec
<Build instructions: files or areas in scope, and what is out of scope.>

## Done when
<Checkable conditions: tests that pass, questions answered.>
EOF
  echo "$dir/brief.md"
}

# Start the agent terminal for a task whose meta is already written. A worker
# runs its role's hc template on <message>; a project lead runs Claude Code on
# its /orchestrate command.
launch() { # <name> [<message>]
  local name=$1 role cwd space out
  local -a agent
  role=$(meta_get "$name" role)
  cwd=$(meta_get "$name" cwd)
  if [ "$role" = lead ]; then
    agent=(claude --model claude-opus-5-5 --permission-mode auto "/orchestrate $(meta_get "$name" project)")
  else
    agent=("$role" "$2")
  fi
  # Show agents in the launcher's Herdr space when it runs in one.
  space=fleet
  if [ -n "${HC_TERMINAL_ID:-}" ]; then
    space=$("$HC" get "$HC_TERMINAL_ID" --json 2>/dev/null | jqr '.labels["herdr.space"] // empty' || true)
    space=${space:-fleet}
  fi
  # Detached from the launcher: the agent outlives it and hc sends it no notes.
  # MSYS_NO_PATHCONV keeps Git Bash from rewriting "/orchestrate" as a path.
  out=$(MSYS_NO_PATHCONV=1 "$HC" run --bg --json --no-parent --outlive-parent --no-notify \
    --name "$name" --cwd "$cwd" \
    --label "herdr.space=$space" --label "herdr.tab=$name" \
    "${agent[@]}") || die "hc run failed: $out"
  # A project lead's command is a launch argument, so only a template's first message can go undelivered.
  if [ "$role" = lead ] || [ "$(printf '%s' "$out" | jqr '.first_message.sent // false')" = true ]; then
    echo "started $name ($role) in $cwd"
  else
    # The undelivered message carried the template's role instructions too,
    # and hc cannot resend it, so point the worker at the template itself.
    echo "started $name, but its brief was not delivered."
    echo "Check its screen with: hc read $name"
    echo "Once clear, deliver it with: hc send $name \"Your role instructions are in $FLEET_ROOT/herdr-core/templates/$role.md (skip its frontmatter). Read them in full. $2\""
  fi
}

cmd_spawn() {
  [ $# -eq 3 ] || die "usage: fleet spawn <name> <implement|investigate> <project>"
  need
  local name=$1 role=$2 project=$3 dir repo cwd branch="" base="" report=""
  dir=$(task_dir "$name")
  case $role in implement|investigate) ;; *) die "role must be implement or investigate" ;; esac
  repo=$(need_project "$project")
  [ "$(scope)" = "$project" ] || die "workers for $project are started by its project lead"
  [ -f "$dir/brief.md" ] || die "no brief; run: fleet new $name"
  [ ! -e "$dir/meta" ] || die "task $name was already spawned; use fleet relaunch $name"
  ! grep -q '^<.*>$' "$dir/brief.md" || die "brief still has placeholder lines: $dir/brief.md"
  ! "$HC" get "$name" --json >/dev/null 2>&1 || die "an hc terminal named $name already exists"

  if [ "$role" = implement ]; then
    if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
      git -C "$repo" fetch -q origin || die "git fetch origin failed in $repo"
    fi
    base=$(git -C "$repo" symbolic-ref -q --short refs/remotes/origin/HEAD \
      || git -C "$repo" rev-parse --abbrev-ref HEAD)
    branch=fleet/$name
    cwd=$FLEET_HOME/worktrees/$(basename "$repo")/$name
    git -C "$repo" worktree add -q -b "$branch" "$cwd" "$base" || die "git worktree add failed"
  else
    cwd=$repo
    report=$FLEET_HOME/reports/$name.md
    mkdir -p "$FLEET_HOME/reports"
  fi

  printf 'role=%s\nrepo=%s\ncwd=%s\nbranch=%s\nbase=%s\nreport=%s\nseen=0\nacked_state=\nacked_turn=0\n' \
    "$role" "$repo" "$cwd" "$branch" "$base" "$report" > "$dir/meta"
  : > "$dir/status"
  {
    printf '\n## Fleet\n- Role: %s\n- Status file: %s\n' "$role" "$dir/status"
    if [ "$role" = implement ]; then
      printf -- '- Worktree: %s (branch %s, based on %s)\n' "$cwd" "$branch" "$base"
    else
      printf -- '- Repository (read-only): %s\n- Report file: %s\n' "$cwd" "$report"
    fi
  } >> "$dir/brief.md"

  launch "$name" "Your brief is $dir/brief.md. Read it in full, then do the task."
}

cmd_relaunch() {
  [ $# -eq 1 ] || die "usage: fleet relaunch <name>"
  need
  local name=$1 dir state
  dir=$(task_dir "$name")
  [ -f "$dir/meta" ] || die "task $name was never spawned"
  read -r state _ < <(worker "$name")
  case $state in
    gone) ;;
    exited) "$HC" rm "$name" >/dev/null ;;
    *) die "$name is still running ($state); stop it first with: hc kill $name" ;;
  esac
  meta_set "$name" acked_state ""
  meta_set "$name" acked_turn 0
  launch "$name" "You are resuming a task an earlier worker started. Your brief is $dir/brief.md. Read it in full, then check what is already done (git status, git log, the Status file) before continuing."
}

# --- news -----------------------------------------------------------------

# The outcome of a worker task once its project lead has handled the task's
# latest news and left it there, for the orchestrator; or nothing. Passing these
# up is fleet's job, so no outcome depends on a project lead remembering to
# report it.
outcome() { # <name>
  local name=$1 state last rest report
  [ "$(status_lines "$name")" -le "$(meta_get "$name" seen)" ] || return 0
  read -r state _ < <(worker "$name")
  case $state in working|starting) return 0 ;; esac
  last=$(tail -n 1 "$TASKS/$name/status" 2>/dev/null || true)
  rest=${last#*: }
  case ${last%%:*} in
    done)
      if [ "$(meta_get "$name" role)" = investigate ]; then
        # The report path comes from fleet's record, not the worker's line.
        report=$(meta_get "$name" report)
        echo "$name: findings in $report: ${rest#"$report "}"
      else
        echo "$name: PR ready: $rest"
      fi ;;
    failed) echo "$name: failed: $rest" ;;
    *)
      if [ "$state" = blocked ] && [ "$(meta_get "$name" acked_state)" = blocked ]; then
        echo "$name: worker is waiting on a permission prompt"
      fi ;;
  esac
}

# An agent stopped or stuck in a state whoever supervises it has not acked, or nothing.
# A project lead sits idle between requests, so idle is news only for workers.
stopped() { # <name> <states>
  local name=$1 state turn acked acked_turn last
  read -r state turn < <(worker "$name")
  acked=$(meta_get "$name" acked_state)
  acked_turn=$(meta_get "$name" acked_turn)
  # Forget an acknowledged state once the agent is busy again, so the next
  # block or stop is news.
  if [ "$state" = working ] && [ -n "$acked" ]; then meta_set "$name" acked_state ""; return; fi
  [[ " $2 " == *" $state "* ]] || return 0
  [ "$state" != "$acked" ] || [ "$turn" != "${acked_turn:-0}" ] || return 0
  # A worker sitting idle or gone after its handled final line is finished, not news.
  last=$(tail -n 1 "$TASKS/$name/status" 2>/dev/null | cut -d: -f1)
  case $state:$last in idle:done|idle:failed|exited:done|exited:failed|gone:done|gone:failed) return ;; esac
  echo "$name: agent $state"
}

# What a task has for whoever supervises it, or nothing. For a project lead: its reports,
# its own stop, and its project's outcomes not yet passed up.
attention() { # <name>
  local name=$1 seen task row rows=""
  seen=$(meta_get "$name" seen)
  if [ "$(status_lines "$name")" -gt "${seen:-0}" ]; then
    echo "$name: new status:"
    tail -n "+$(( ${seen:-0} + 1 ))" "$TASKS/$name/status" | sed 's/^/  /'
    [ "$(meta_get "$name" role)" = lead ] || return 0
  fi
  if [ "$(meta_get "$name" role)" != lead ]; then
    stopped "$name" "blocked error exited gone idle"
    return
  fi
  stopped "$name" "blocked error exited gone"
  for task in $(project_tasks "$(meta_get "$name" repo)"); do
    row=$(outcome "$task")
    [ -z "$row" ] || [ "$row" = "$(cat "$TASKS/$task/up" 2>/dev/null)" ] || rows+="  $row"$'\n'
  done
  [ -z "$rows" ] || printf '%s: outcomes:\n%s' "$name" "$rows"
}

# Every attention line of this session's tasks, or nothing.
news() {
  local name out=""
  for name in $(my_tasks); do out+="$(attention "$name")"$'\n'; done
  printf '%s' "$out" | sed '/^$/d'
}

cmd_wait() {
  local timeout=100
  if [ "${1:-}" = --timeout ]; then timeout=${2:?}; shift 2; fi
  [ $# -eq 0 ] || die "usage: fleet wait [--timeout SECONDS]"
  need
  local deadline=$(( $(date +%s) + timeout )) out
  while :; do
    out=$(news)
    if [ -n "$out" ]; then printf '%s\n' "$out"; return; fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      [ -n "$(my_tasks)" ] && echo "timeout: nothing new" || echo "no tasks"
      return
    fi
    sleep 5
  done
}

# A session's watch: an asyncRewake Stop hook the orchestrate skill registers.
# Claude Code starts one at every turn end of the session and never cancels the
# earlier ones, so the newest records its pid in its session's folder and older
# ones of that session exit; other sessions' watches run on. Exit 2 wakes the
# idle session with stderr as its message; exit 0 is silent.
HOOK_FAILED=$FLEET_HOME/hook.failed
# Under the hook's 28800-second timeout in SKILL.md: Claude Code drops the
# wake of a hook it timed out, so the watch ends itself first.
HOOK_SECONDS=28500

cmd_hook() {
  [ $# -eq 0 ] || die "usage: fleet hook (run by Claude Code, not by hand)"
  local payload err deadline out name entry sent pidfile
  payload=$(cat)
  [ -n "$(tasks)" ] || exit 0
  # Report a broken watch once, not at every turn end.
  if ! err=$(need 2>&1); then
    [ ! -e "$HOOK_FAILED" ] || exit 0
    printf '%s\n' "$err" > "$HOOK_FAILED"
    echo "fleet: this session's watch cannot run: $err. Tell the user; until it is fixed, supervise with bin/fleet wait." >&2
    exit 2
  fi
  rm -f "$HOOK_FAILED"
  SESSION=$(printf '%s' "$payload" | jqr '.session_id // empty')
  [ -n "$SESSION" ] || die "the hook's payload has no session_id"
  [ -n "$(my_tasks)" ] || exit 0
  mkdir -p "$SESSIONS/$SESSION"
  pidfile=$SESSIONS/$SESSION/hook.pid
  echo $$ > "$pidfile"
  deadline=$(( $(date +%s) + HOOK_SECONDS ))
  while [ "$(cat "$pidfile" 2>/dev/null)" = $$ ]; do
    # Each task's entry wakes the session once; ack clears its sent record so the
    # task's next news wakes it again.
    out=""
    for name in $(my_tasks); do
      entry=$(attention "$name"); sent=$TASKS/$name/sent
      if [ -z "$entry" ]; then
        rm -f "$sent"
      elif [ "$entry" != "$(cat "$sent" 2>/dev/null)" ]; then
        printf '%s\n' "$entry" > "$sent"
        out+="$entry"$'\n'
      fi
    done
    if [ -n "$out" ]; then
      printf 'fleet news:\n%sHandle each entry, then bin/fleet ack <name>.\n' "$out" >&2
      exit 2
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "fleet: nothing new for $(( HOOK_SECONDS / 3600 )) hours; the watch restarts when this turn ends." >&2
      exit 2
    fi
    sleep 5
  done
}

# Acking a project lead also marks its project's outcomes as passed up.
cmd_ack() {
  [ $# -eq 1 ] || die "usage: fleet ack <name>"
  need
  local name=$1 state turn task row
  [ -f "$(task_dir "$name")/meta" ] || die "no task $name"
  read -r state turn < <(worker "$name")
  meta_set "$name" seen "$(status_lines "$name")"
  meta_set "$name" acked_state "$( [ "$state" = working ] || echo "$state")"
  meta_set "$name" acked_turn "$turn"
  rm -f "$TASKS/$name/sent"
  [ "$(meta_get "$name" role)" = lead ] || return 0
  for task in $(project_tasks "$(meta_get "$name" repo)"); do
    row=$(outcome "$task")
    if [ -n "$row" ]; then printf '%s\n' "$row" > "$TASKS/$task/up"; else rm -f "$TASKS/$task/up"; fi
  done
}

# --- views ----------------------------------------------------------------

# The task's pull request as "<STATE> <url> <head sha>", or nothing.
pr_of() { # <name>
  local repo branch
  repo=$(meta_get "$1" repo); branch=$(meta_get "$1" branch)
  [ -n "$branch" ] || return 0
  (cd "$repo" && gh pr view "$branch" --json state,url,headRefOid \
    -q '.state + " " + .url + " " + .headRefOid' 2>/dev/null) || true
}

cmd_ls() {
  [ $# -eq 0 ] || die "usage: fleet ls"
  need
  local name state turn seen lines last pr project
  project=$(scope)
  echo "tasks in $TASKS for ${project:-the orchestrator}"
  [ -n "$(my_tasks)" ] || { echo "(none)"; return; }
  printf '%-24s %-16s %-12s %-9s %-4s %s\n' TASK PROJECT ROLE AGENT NEW "LAST STATUS / PR"
  for name in $(my_tasks); do
    read -r state turn < <(worker "$name")
    seen=$(meta_get "$name" seen); lines=$(status_lines "$name")
    last=$(tail -n 1 "$TASKS/$name/status" 2>/dev/null || true)
    pr=$(pr_of "$name" | cut -d' ' -f1,2)
    printf '%-24s %-16s %-12s %-9s %-4s %s\n' "$name" "$(project_of "$(meta_get "$name" repo)")" \
      "$(meta_get "$name" role)" "$state" \
      "$(( lines - ${seen:-0} ))" "${last:--}${pr:+ | PR $pr}"
  done
}

# What a finished task delivered, as "<project>/<task>: <delivery>", or
# nothing: a merged PR, or an investigation's answer and report. Pass the
# task's pr_of line when it is already known, to skip looking it up again.
landed_row() { # <name> [<pr_of line>]
  local name=$1 last rest pr url delivery=""
  last=$(tail -n 1 "$TASKS/$name/status" 2>/dev/null || true)
  [ "${last%%:*}" = done ] || return 0
  rest=${last#*: }
  if [ "$(meta_get "$name" role)" = investigate ]; then
    delivery="${rest#* } (report ${rest%% *})"
  else
    read -r pr url _ <<< "${2:-$(pr_of "$name")}"
    [ "$pr" != MERGED ] || delivery="merged $url"
  fi
  [ -z "$delivery" ] || printf '%s/%s: %s\n' "$(project_of "$(meta_get "$name" repo)")" "$name" "$delivery"
}

# Every clean of a delivered task appends its landed_row here, dated, so the
# digest can show what landed after the task's record is gone.
LANDED=$FLEET_HOME/landed
LANDED_SHOWN=6

digest_section() { # <title> <rows>
  echo "$1"
  if [ -n "$2" ]; then printf '%s\n' "$2" | sed 's/^/  /'; else echo "  (none)"; fi
}

# Where every worker task stands, for the user: what needs them, what is still
# running, what is finished and ready to clean, and what recently landed and
# was cleaned. Rows are <project>/<task>, sorted so each project's tasks sit
# together; recently landed is newest first.
cmd_digest() {
  [ $# -eq 0 ] || die "usage: fleet digest"
  need
  local name state turn last rest summary prline pr url row needs="" underway="" finished=""
  for name in $(tasks); do
    [ "$(meta_get "$name" role)" != lead ] || continue
    read -r state turn < <(worker "$name")
    last=$(tail -n 1 "$TASKS/$name/status" 2>/dev/null || true)
    rest=${last#*: }; summary=${rest#* }
    row="$(project_of "$(meta_get "$name" repo)")/$name:"
    # A busy worker is underway whatever it last reported: its project lead has
    # answered its question or sent it back for more.
    if [ "$state" = working ] || [ "$state" = starting ]; then
      underway+="$row $state"$'\n'
      continue
    fi
    # News its project lead has not handled yet is the lead's, not the user's.
    if [ "$(status_lines "$name")" -gt "$(meta_get "$name" seen)" ]; then
      underway+="$row with its project lead: $last"$'\n'
      continue
    fi
    case ${last%%:*} in
      blocked) needs+="$row asks: $rest"$'\n' ;;
      failed) needs+="$row failed: $rest"$'\n' ;;
      done)
        if [ "$(meta_get "$name" role)" = investigate ]; then
          finished+="$(landed_row "$name")"$'\n'
        else
          prline=$(pr_of "$name")
          read -r pr url _ <<< "$prline"
          case $pr in
            MERGED) finished+="$(landed_row "$name" "$prline")"$'\n' ;;
            OPEN) needs+="$row PR to review: $url $summary"$'\n' ;;
            *) needs+="$row done, but its PR is ${pr:-missing}${url:+ ($url)}"$'\n' ;;
          esac
        fi ;;
      *)
        if [ "$state" = blocked ]; then needs+="$row worker is waiting on a prompt"$'\n'
        else underway+="$row stalled: worker $state before reporting"$'\n'; fi ;;
    esac
  done
  digest_section "Needs you" "$(printf '%s' "$needs" | sort)"
  digest_section "Underway" "$(printf '%s' "$underway" | sort)"
  digest_section "Finished" "$(printf '%s' "$finished" | sort)"
  digest_section "Recently landed" \
    "$(tail -n "$LANDED_SHOWN" "$LANDED" 2>/dev/null | awk '{ l[NR] = $0 } END { for (i = NR; i > 0; i--) print l[i] }')"
}

cmd_clean() {
  local discard=false name="" arg
  for arg in "$@"; do
    if [ "$arg" = --discard ]; then discard=true
    elif [ -z "$name" ]; then name=$arg
    else die "usage: fleet clean <name> [--discard]"
    fi
  done
  [ -n "$name" ] || die "usage: fleet clean <name> [--discard]"
  need
  local dir role repo cwd branch base report pr="" head merged i row left
  dir=$(task_dir "$name")
  [ -f "$dir/meta" ] || die "no task $name"
  role=$(meta_get "$name" role); repo=$(meta_get "$name" repo)
  cwd=$(meta_get "$name" cwd); branch=$(meta_get "$name" branch); base=$(meta_get "$name" base)

  # A project lead goes only once its project has no tasks left to supervise.
  if [ "$role" = lead ]; then
    left=$(project_tasks "$repo" | xargs)
    [ -z "$left" ] || die "$name still supervises $left; clean those first"
  fi

  # Landed means merged PR containing every local commit, or nothing to land.
  if [ "$role" = implement ] && [ -d "$cwd" ] && ! $discard; then
    [ -z "$(git -C "$cwd" status --porcelain)" ] \
      || die "$name has uncommitted changes in $cwd; not cleaning (--discard drops them)"
    pr=$(pr_of "$name")
    head=$(git -C "$cwd" rev-parse HEAD)
    if [ "${pr%% *}" = MERGED ]; then
      # The PR head may exist only on GitHub (e.g. "Update branch" merged the
      # base into it), so fetch it before asking whether it contains HEAD.
      merged=${pr##* }
      git -C "$cwd" cat-file -e "$merged^{commit}" 2>/dev/null \
        || git -C "$cwd" fetch -q origin "$merged" 2>/dev/null || true
      git -C "$cwd" merge-base --is-ancestor "$head" "$merged" 2>/dev/null \
        || die "$name has commits that are not in its merged PR; not cleaning (--discard drops them)"
    elif [ "$(git -C "$cwd" rev-list --count "$base..$head")" != 0 ]; then
      die "$name has unmerged work${pr:+ (PR ${pr% *})}; not cleaning (--discard drops it)"
    fi
  fi

  if "$HC" get "$name" --json >/dev/null 2>&1; then
    "$HC" kill "$name" >/dev/null 2>&1 || true
    for i in 1 2 3 4 5; do
      "$HC" rm "$name" >/dev/null 2>&1 && break
      sleep 1
    done
    ! "$HC" get "$name" --json >/dev/null 2>&1 || die "could not remove hc terminal $name"
  fi
  if [ "$role" = implement ]; then
    [ ! -d "$cwd" ] || git -C "$repo" worktree remove $($discard && echo --force) "$cwd"
    ! git -C "$repo" rev-parse -q --verify "refs/heads/$branch" >/dev/null \
      || git -C "$repo" branch -q -D "$branch"
  fi
  report=$(meta_get "$name" report)
  if [ "$role" != lead ] && ! $discard; then
    row=$(landed_row "$name" "$pr")
    [ -z "$row" ] || printf '%s %s\n' "$(date +%F)" "$row" >> "$LANDED"
  fi
  rm -rf "$dir"
  echo "cleaned $name${report:+; report kept at $report}"
}

case ${1:-help} in
  project) shift; cmd_project "$@" ;;
  scope) shift; cmd_scope "$@" ;;
  lead) shift; cmd_lead "$@" ;;
  report) shift; cmd_report "$@" ;;
  new) shift; cmd_new "$@" ;;
  spawn) shift; cmd_spawn "$@" ;;
  relaunch) shift; cmd_relaunch "$@" ;;
  wait) shift; cmd_wait "$@" ;;
  hook) shift; cmd_hook "$@" ;;
  ack) shift; cmd_ack "$@" ;;
  ls) shift; cmd_ls "$@" ;;
  digest) shift; cmd_digest "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
